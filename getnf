#!/usr/bin/env bash
#
# getnf: A better way to install Nerd Fonts
#
# Author: @ronniedroid
# Maintainer: @trimclain
# License: GPL-3.0

readonly VERSION="0.5.0-dev"

readonly NERDFONTSAPI='https://api.github.com/repos/ryanoasis/nerd-fonts'
readonly NERDFONTSREPO='https://github.com/ryanoasis/nerd-fonts'

ON_MAC='false'
if [[ $(uname) == "Darwin" ]]; then
    ON_MAC='true'
fi
readonly ON_MAC

readonly GETNF_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/getnf"
readonly FONT_RELEASES_DIR="$GETNF_DIR/releases"
readonly RELEASE_FILE="$GETNF_DIR/release.txt"
readonly ALL_FONTS_FILE="$GETNF_DIR/all_fonts.txt"

NEW_RELEASE_AVAILABLE='false'
OPERATE_GLOBALLY='false'
KEEP_FONT_ARCHIVES='false'
INCLUDE_INSTALLED_FONTS='false'

DOWN_DIR=''
FONT_DIR=''
LOADING_ANIMATION_PID=''
LOADING_ANIMATION_ACTIVE='false'

OLIVE=''
CYAN=''
RED=''
GREEN=''
RESET=''
ITALIC=''
if command -v tput > /dev/null && [[ -t 1 ]]; then
    # Use terminal capabilities for colors rather than hard-coded escapes.
    # Colors: https://www.ditig.com/publications/256-colors-cheat-sheet
    OLIVE=$(tput setaf 3)
    CYAN=$(tput setaf 6)
    RED=$(tput setaf 9)
    GREEN=$(tput setaf 2)
    RESET=$(tput sgr0)
    ITALIC=$'\e[3m'
fi
readonly OLIVE CYAN RED GREEN RESET ITALIC

readonly ANIMATION=('-' "\\" '|' '/')
readonly FRAME_INTERVAL=0.25

#######################################
# Display command-line options and usage examples.
# Arguments:
#   None
# Outputs:
#   Writes help to stdout.
#######################################
display_help() {
    cat << EOF
Usage:
  getnf [options]

OPTIONS:
  -h          display this help message
  -k          keep the downloaded font archives
  -a          show already installed Nerd Fonts in the menu
  -g          install/uninstall/list/update Nerd Fonts for all users
  -l          show the list of installed Nerd Fonts
  -L          show the list of all Nerd Fonts
  -f          select and install Nerd Fonts using fzf
  -i <font>   directly install the specified Nerd Fonts
  -u <font>   uninstall the specified Nerd Fonts
  -U          update all installed Nerd Fonts
  -V          display current getnf version

To install fonts using the menu:
- Choose one or more fonts (by index/number) to install
- Hit Return/Enter to install the selected fonts
- Type 'q' to quit

To install fonts directly:
- Get the exact name of a font from the menu
- Use 'getnf -i "<font-name>"' to install a font
- Use 'getnf -i "<name1>,<name2>"' to install multiple fonts

To uninstall fonts use the same syntax as for direct install.

To install, uninstall, list, update fonts for all users use -gi, -gu, -gl, -gU.
EOF
}

info() {
    printf '%s\n' "$1"
}

title() {
    printf '\n%s%b%s\n' "$OLIVE" "$1" "$RESET"
}

confirm() {
    printf '%s%b%s\n' "$GREEN" "$1" "$RESET"
}

alert() {
    printf '%s%b%s\n' "$RED" "$1" "$RESET"
}

#######################################
# Print an error and exit the script with status 1.
# Arguments:
#   Error message.
# Outputs:
#   Writes the message to stderr.
#######################################
error() {
    alert "$1" >&2
    exit 1
}

#######################################
# Print an argument error and help, then exit with status 1.
# Arguments:
#   Error message.
# Outputs:
#   Writes the error and help to stderr.
#######################################
usage_error() {
    alert "$1" >&2
    printf '\n' >&2
    display_help >&2
    exit 1
}

#######################################
# Exit with status 1 if a required command is unavailable.
# Arguments:
#   Command name.
# Outputs:
#   Writes an error to stderr if the command is missing.
#######################################
ensure_installed() {
    if ! command -v "$1" > /dev/null; then
        error "Dependency $1 is not installed on your system."
    fi
}

# Loading animation adapted from:
# https://github.com/Silejonu/bash_loading_animations

erase_line() {
    # Move up one line and erase it.
    printf '\033[1A\033[2K'
}

erase_char() {
    # Move left one column and erase to the end of the line.
    printf '\033[1D\033[K'
}

#######################################
# Draw animation frames until the background process is stopped.
# Globals:
#   ANIMATION
#   FRAME_INTERVAL
# Arguments:
#   None
# Outputs:
#   Writes animation frames and erase sequences to stdout.
#######################################
play_loading_animation_loop() {
    while true; do
        local frame
        for frame in "${ANIMATION[@]}"; do
            printf '\033[1D\033[K%s' "$frame"
            sleep "$FRAME_INTERVAL"
        done
    done
}

#######################################
# Start the background animation and record its process ID.
# Globals:
#   LOADING_ANIMATION_PID
#   LOADING_ANIMATION_ACTIVE
# Arguments:
#   None
# Outputs:
#   Writes animation frames and erase sequences to stdout in the background.
#   Hides the cursor when stdout is a terminal.
#######################################
start_loading_animation() {
    if command -v tput > /dev/null && [[ -t 1 ]]; then
        tput civis # Hide the terminal cursor.
    fi
    play_loading_animation_loop &
    LOADING_ANIMATION_PID="${!}"
    LOADING_ANIMATION_ACTIVE='true'
}

#######################################
# Stop an active animation and restore the terminal cursor.
# Globals:
#   LOADING_ANIMATION_PID
#   LOADING_ANIMATION_ACTIVE
# Arguments:
#   None
# Outputs:
#   Writes erase and cursor-restoration sequences to stdout.
# Returns:
#   0 if no animation is active; otherwise the last command status.
#######################################
stop_loading_animation() {
    [[ "$LOADING_ANIMATION_ACTIVE" == "true" ]] || return 0
    erase_char
    kill "$LOADING_ANIMATION_PID" &> /dev/null
    wait "$LOADING_ANIMATION_PID" &> /dev/null
    LOADING_ANIMATION_PID=''
    LOADING_ANIMATION_ACTIVE='false'
    if command -v tput > /dev/null && [[ -t 1 ]]; then
        tput cnorm # Restore the terminal cursor.
    fi
}

handle_interrupt() {
    alert '\nInterrupted. Exiting.' >&2
    exit 130
}

handle_termination() {
    alert '\nTerminated. Exiting.' >&2
    exit 143
}

handle_hangup() {
    alert '\nTerminal disconnected. Exiting.' >&2
    exit 129
}

#######################################
# Stop the animation and remove temporary downloads unless kept with -k.
# Globals:
#   DOWN_DIR
#   KEEP_FONT_ARCHIVES
#   LOADING_ANIMATION_PID
#   LOADING_ANIMATION_ACTIVE
# Arguments:
#   None
#######################################
cleanup() {
    stop_loading_animation
    if [[ -n "$DOWN_DIR" && "$KEEP_FONT_ARCHIVES" == "false" ]]; then
        rm -rf -- "$DOWN_DIR"
    fi
}

#######################################
# Set FONT_DIR for the selected platform and installation scope.
# Globals:
#   ON_MAC
#   OPERATE_GLOBALLY
#   HOME
#   FONT_DIR
# Arguments:
#   None
#######################################
get_font_dir() {
    if [[ "$ON_MAC" == "true" ]] && [[ "$OPERATE_GLOBALLY" == "true" ]]; then
        FONT_DIR="/Library/Fonts"
    elif [[ "$ON_MAC" == "true" ]]; then
        FONT_DIR="$HOME/Library/Fonts"
    elif [[ "$OPERATE_GLOBALLY" == "true" ]]; then
        FONT_DIR="/usr/local/share/fonts"
    else
        FONT_DIR="$HOME/.local/share/fonts"
    fi
    readonly FONT_DIR
}

#######################################
# Create the download directory and set DOWN_DIR.
# Globals:
#   KEEP_FONT_ARCHIVES
#   HOME
#   TMPDIR
#   DOWN_DIR
# Arguments:
#   None
# Outputs:
#   Writes errors to stderr.
# Returns:
#   0 on success, nonzero if the directory cannot be prepared.
#######################################
init_down_dir() {
    local down_dir
    if [[ "$KEEP_FONT_ARCHIVES" == "true" ]]; then
        if command -v xdg-user-dir > /dev/null; then
            down_dir=$(xdg-user-dir DOWNLOAD) || {
                alert "Could not determine the download directory." >&2
                return 1
            }
            [[ -n "$down_dir" ]] || {
                alert "The download directory is empty." >&2
                return 1
            }
            down_dir="$down_dir/getnf"
        else
            down_dir="$HOME/Downloads/getnf"
        fi
        mkdir -p "$down_dir" || {
            alert "Could not create download directory: $down_dir" >&2
            return 1
        }
    else
        down_dir=$(mktemp -d "${TMPDIR:-/tmp}/getnf.XXXXXX") || {
            alert "Could not create temporary download directory in ${TMPDIR:-/tmp}." >&2
            return 1
        }
    fi
    readonly DOWN_DIR="$down_dir"
}

#######################################
# Prepare download, font, and installation-record directories.
# Globals:
#   OPERATE_GLOBALLY
#   FONT_DIR
#   DOWN_DIR
#   FONT_RELEASES_DIR
# Arguments:
#   None
# Outputs:
#   Writes errors to stderr; sudo may prompt for authentication.
# Returns:
#   0 on success, nonzero if directory preparation fails.
#######################################
create_dirs() {
    init_down_dir || return 1
    get_font_dir
    if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
        sudo mkdir -p "$FONT_DIR" || {
            alert "Could not create global font directory: $FONT_DIR" >&2
            return 1
        }
    else
        mkdir -p "$FONT_DIR" || {
            alert "Could not create font directory: $FONT_DIR" >&2
            return 1
        }
    fi
    mkdir -p "$FONT_RELEASES_DIR" || {
        alert "Could not create font state directory: $FONT_RELEASES_DIR" >&2
        return 1
    }
}

#######################################
# Check whether a connectivity endpoint responds with HTTP 204.
# Arguments:
#   Endpoint URL.
#   Connection timeout in seconds.
#   Overall timeout in seconds.
# Returns:
#   0 for HTTP 204, 1 otherwise.
#######################################
_probe_204() {
    local url="$1"
    local connect_timeout="$2"
    local max_time="$3"

    [[ "$(curl -o /dev/null -s \
        --connect-timeout "$connect_timeout" \
        --max-time "$max_time" \
        -w '%{http_code}' \
        "$url" 2> /dev/null || true)" == "204" ]]
}

#######################################
# Try connectivity probes; exit with status 1 if neither succeeds.
# Arguments:
#   None
# Outputs:
#   Writes an error to stderr if both probes fail.
#######################################
verify_internet_access() {
    _probe_204 "http://connectivitycheck.gstatic.com/generate_204" 1 2 ||
        _probe_204 "https://cp.cloudflare.com/generate_204" 2 3 ||
        error "Internet connection is required for getnf to work."
}

#######################################
# Check curl and connectivity, then prepare runtime directories.
# Globals:
#   DOWN_DIR
#   FONT_DIR
# Arguments:
#   None
# Outputs:
#   Writes errors to stderr; sudo may prompt for authentication.
# Returns:
#   0 on success, nonzero on directory failure; exits on failed checks.
#######################################
check_dependencies() {
    ensure_installed curl
    verify_internet_access
    create_dirs || return 1
}

#######################################
# Fetch RELEASE and set NEW_RELEASE_AVAILABLE by comparing the cache.
# Leave release-marker persistence to get_all_fonts after catalog refresh.
# Globals:
#   NERDFONTSAPI
#   RELEASE_FILE
#   RELEASE
#   NEW_RELEASE_AVAILABLE
# Arguments:
#   None
# Outputs:
#   Writes request and validation errors to stderr.
# Returns:
#   0 on success, nonzero on request failure, unusable data, or read failure.
#######################################
get_latest_release_version() {
    local response current_release
    response=$(curl --fail --silent --show-error "$NERDFONTSAPI/releases/latest") || {
        alert "Could not fetch latest release metadata." >&2
        return 1
    }
    RELEASE=$(printf '%s\n' "$response" |
        awk -v RS=',' -F'"' '/"tag_name"[[:space:]]*:/ {print $4}')
    # These are parsed-value checks, not structural JSON validation.
    if [[ ! "$RELEASE" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]]; then
        alert "Unusable release metadata." >&2
        return 1
    fi
    current_release=''
    if [[ -f "$RELEASE_FILE" ]]; then
        current_release=$(cat "$RELEASE_FILE") || return 1
    fi
    NEW_RELEASE_AVAILABLE='false'
    if [[ "$current_release" != "$RELEASE" ]]; then
        NEW_RELEASE_AVAILABLE='true'
    fi
    # Persist only after the catalog refresh succeeds (see get_all_fonts).
}

#######################################
# Get the installation-record path for a font in the selected scope.
# Globals:
#   OPERATE_GLOBALLY
#   FONT_RELEASES_DIR
# Arguments:
#   Font name.
# Outputs:
#   Writes the record path to stdout.
#######################################
get_font_release_file() {
    if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
        echo "$FONT_RELEASES_DIR/${1}_release.global.txt"
    else
        echo "$FONT_RELEASES_DIR/${1}_release.txt"
    fi
}

#######################################
# Check whether a font has a saved version matching RELEASE.
# Globals:
#   RELEASE
# Arguments:
#   Font name.
# Returns:
#   0 if the saved version matches, 1 otherwise.
#######################################
is_latest_version() {
    local font_release_file
    font_release_file="$(get_font_release_file "$1")"
    if [[ -f "$font_release_file" ]]; then
        local font_release_version
        font_release_version=$(cat "$font_release_file")
        if [[ "$font_release_version" == "$RELEASE" ]]; then
            return 0
        fi
    fi
    return 1
}

#######################################
# Fetch the master-branch catalog and replace its cache after value checks.
# Globals:
#   NERDFONTSAPI
#   ALL_FONTS_FILE
# Arguments:
#   None
# Outputs:
#   Writes request, validation, and persistence errors to stderr.
# Returns:
#   0 on success, nonzero on request, validation, or persistence failure.
#######################################
create_all_fonts_file() {
    local response font_list
    response=$(curl --fail --silent --show-error "$NERDFONTSAPI/contents/patched-fonts?ref=master") || {
        alert "Could not fetch font catalog." >&2
        return 1
    }
    font_list=$(printf '%s\n' "$response" |
        awk -v RS=',' -F'"' '/"name"[[:space:]]*:/ {print $4}')
    if ! valid_font_catalog "$font_list"; then
        alert "Unusable font catalog." >&2
        return 1
    fi
    replace_metadata_file "$ALL_FONTS_FILE" "$font_list"
}

#######################################
# Check that extracted catalog names are nonempty and use safe characters.
# This validates parsed values, not JSON structure.
# Arguments:
#   Newline-separated font names.
# Returns:
#   0 if every name is usable, 1 otherwise.
#######################################
valid_font_catalog() {
    local name
    [[ -n "$1" ]] || return 1
    while IFS= read -r name; do
        [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || return 1
    done <<< "$1"
}

#######################################
# Write metadata through a unique sibling file and checked rename.
# Staging beside the destination keeps replacement on the same filesystem.
# Arguments:
#   Destination file path.
#   Text to save; a final newline is appended.
# Outputs:
#   Writes staging and persistence errors to stderr.
# Returns:
#   0 on success, nonzero if staging, writing, or replacement fails.
#######################################
replace_metadata_file() {
    local temporary
    temporary=$(mktemp "$1.tmp.XXXXXX") && [[ -n "$temporary" ]] || {
        alert "Could not stage metadata: $1" >&2
        return 1
    }
    if [[ -d "$1" ]] || ! printf '%s\n' "$2" > "$temporary" ||
        ! mv -f -- "$temporary" "$1"; then
        rm -f -- "$temporary"
        alert "Could not save metadata: $1" >&2
        return 1
    fi
}

#######################################
# Load ALL_FONTS, refreshing a missing or unusable catalog when needed.
# Save a changed release marker only after the catalog is ready.
# Globals:
#   ALL_FONTS_FILE
#   NEW_RELEASE_AVAILABLE
#   RELEASE_FILE
#   RELEASE
#   ALL_FONTS
# Arguments:
#   None
# Outputs:
#   Writes refresh and persistence errors to stderr.
# Returns:
#   0 on success, nonzero if reading, refresh, or persistence fails.
#######################################
get_all_fonts() {
    local line catalog
    catalog=''
    if [[ -f "$ALL_FONTS_FILE" ]]; then
        catalog=$(cat "$ALL_FONTS_FILE") || return 1
    fi
    if [[ "$NEW_RELEASE_AVAILABLE" == "true" ]] || ! valid_font_catalog "$catalog"; then
        create_all_fonts_file || return 1
        catalog=$(cat "$ALL_FONTS_FILE") || return 1
        valid_font_catalog "$catalog" || return 1
    fi
    if [[ "$NEW_RELEASE_AVAILABLE" == "true" ]]; then
        replace_metadata_file "$RELEASE_FILE" "$RELEASE" || return 1
    fi
    ALL_FONTS=()
    # Use read instead of mapfile for macOS Bash 3.2 compatibility.
    # mapfile -t ALL_FONTS < "$ALL_FONTS_FILE" # not available on mac
    while IFS= read -r line; do
        ALL_FONTS+=("$line")
    done <<< "$catalog"
}

#######################################
# Set INSTALLED_FONTS to catalog names found in FONT_DIR.
# Globals:
#   FONT_DIR
#   ALL_FONTS
#   INSTALLED_FONTS
# Arguments:
#   None
#######################################
get_installed_fonts() {
    local font
    local installed_user_fonts=("$FONT_DIR"/*)
    installed_user_fonts=("${installed_user_fonts[@]##*/}")
    INSTALLED_FONTS=()
    for font in "${ALL_FONTS[@]}"; do
        if [[ " ${installed_user_fonts[*]} " == *" $font "* ]]; then
            INSTALLED_FONTS+=("$font")
        fi
    done
}

#######################################
# Build FONT_OPTIONS, hiding current installations unless -a is enabled.
# Globals:
#   INCLUDE_INSTALLED_FONTS
#   ALL_FONTS
#   INSTALLED_FONTS
#   FONT_OPTIONS
# Arguments:
#   None
#######################################
filter_installed_fonts() {
    local font
    if [[ "$INCLUDE_INSTALLED_FONTS" == "false" ]]; then
        FONT_OPTIONS=()
        for font in "${ALL_FONTS[@]}"; do
            # Keep installed fonts selectable when their version is not current.
            if [[ " ${INSTALLED_FONTS[*]} " != *" $font "* ]] ||
                ! is_latest_version "$font"; then
                FONT_OPTIONS+=("$font")
            fi
        done
    else
        FONT_OPTIONS=("${ALL_FONTS[@]}")
    fi
}

#######################################
# Download a font archive into the current working directory.
# Globals:
#   NERDFONTSREPO
#   RELEASE
#   ON_MAC
#   GREEN
#   RESET
# Arguments:
#   Font name.
# Outputs:
#   Writes download status to stdout and curl progress/errors to stderr.
# Returns:
#   0 on success, nonzero if curl fails.
#######################################
download_font() {
    local status=0
    local opts=("--fail" "--show-error" "--location" "--remote-header-name" "--remote-name")
    if [[ $ON_MAC == "false" ]]; then
        opts+=("--silent")
        echo -n "Downloading $1...  "
        start_loading_animation
        curl "${opts[@]}" "$NERDFONTSREPO/releases/download/$RELEASE/$1.tar.xz" || status=$?
        stop_loading_animation
        ((status == 0)) || return "$status"
        confirm "Done"
    else
        # TODO: figure out how to disable messages about bg process termination
        opts+=("--progress-bar")
        info "Downloading $1... "
        curl "${opts[@]}" "$NERDFONTSREPO/releases/download/$RELEASE/$1.tar.xz" || return $?
        erase_line
        erase_line
        echo "Downloading $1... ${GREEN}Done${RESET}"
    fi
}

#######################################
# Extract a font archive into its family directory.
# Globals:
#   OPERATE_GLOBALLY
#   FONT_DIR
# Arguments:
#   Font name.
# Outputs:
#   Writes installation progress to stdout and command errors to stderr.
# Returns:
#   0 on success, nonzero if directory creation or extraction fails.
#######################################
extract_font() {
    echo -n "Installing $1... "
    if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
        sudo mkdir -p "$FONT_DIR/$1" || return $?
        sudo tar -xf "$1.tar.xz" -C "$FONT_DIR/$1" || return $?
    else
        mkdir -p "$FONT_DIR/$1" || return $?
        tar -xf "$1.tar.xz" -C "$FONT_DIR/$1" || return $?
    fi
}

#######################################
# Save RELEASE in the font installation record.
# Globals:
#   RELEASE
# Arguments:
#   Font name.
# Outputs:
#   Writes staging and persistence errors to stderr.
# Returns:
#   0 on success, nonzero if staging, writing, or replacement fails.
#######################################
save_font_release() {
    replace_metadata_file "$(get_font_release_file "$1")" "$RELEASE"
}

#######################################
# Download, extract, and record a font from DOWN_DIR, then restore cwd.
# Marker persistence failure does not roll back extracted font files.
# Globals:
#   DOWN_DIR
# Arguments:
#   Font name.
# Outputs:
#   Writes installation progress to stdout and errors to stderr.
# Returns:
#   0 on success, nonzero if a directory change or installation step fails.
#######################################
install_font() {
    local status=0
    pushd "$DOWN_DIR" > /dev/null || return 1
    # Remove the existing archive so curl -OJ can retry the download.
    rm -f "$DOWN_DIR/$1.tar.xz" &&
        download_font "$1" &&
        extract_font "$1" &&
        save_font_release "$1" &&
        confirm "Done" || status=$?
    popd > /dev/null || return 1
    return "$status"
}

#######################################
# Append requested catalog names to SELECTED_FONTS in input order.
# Exit with status 1 at the first invalid name.
# Globals:
#   ALL_FONTS
#   SELECTED_FONTS
# Arguments:
#   Comma- or space-separated font names.
# Outputs:
#   Writes invalid-name errors to stderr.
#######################################
direct_install() {
    local font_name candidate found
    local IFS=', '

    for font_name in $1; do
        found=0
        for candidate in "${ALL_FONTS[@]}"; do
            if [[ "$candidate" == "$font_name" ]]; then
                found=1
                break
            fi
        done

        if ((found)); then
            SELECTED_FONTS+=("$font_name")
        else
            error "Invalid font name: $font_name. Try again."
        fi
    done
}

#######################################
# Validate every requested font before removing managed installations.
# Exit with status 1 on invalid input or a removal failure.
# Globals:
#   FONT_DIR
#   OPERATE_GLOBALLY
# Arguments:
#   Comma- or whitespace-separated font names.
# Outputs:
#   Writes removal progress to stdout and errors to stderr.
#######################################
uninstall_fonts() {
    get_font_dir
    local -a fonts_to_uninstall=() names=()
    local remaining="$1" segment font marker
    while true; do
        segment=${remaining%%,*}
        # Reject multiline input.
        [[ "$segment" != *$'\n'* && "$segment" != *$'\r'* ]] ||
            error "Invalid font selection."
        IFS=$' \t' read -r -a names <<< "$segment"
        # Reject empty input and empty comma fields, such as "Hack,,Other".
        ((${#names[@]} > 0)) || error "Empty font name."

        for font in "${names[@]}"; do
            [[ "$font" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.+-]*$ ]] ||
                error "Invalid font name: $font."
            marker=$(get_font_release_file "$font")
            [[ -d "$FONT_DIR/$font" ]] || error "Font $font not found."
            [[ -f "$marker" ]] || error "Font $font is not managed by getnf."
            fonts_to_uninstall+=("$font")
        done

        [[ "$remaining" == *,* ]] || break
        remaining=${remaining#*,}
    done
    for font in "${fonts_to_uninstall[@]}"; do
        printf 'Uninstalling %s... ' "$font"
        if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
            sudo rm -rf -- "${FONT_DIR:?}/$font" ||
                error "Failed to uninstall font $font."
        else
            rm -rf -- "${FONT_DIR:?}/$font" ||
                error "Failed to uninstall font $font."
        fi
        rm -f -- "$(get_font_release_file "$font")" ||
            error "Font $font removed; failed to clear its saved information."
        confirm "Done"
    done
}

#######################################
# Show the archive location if kept and announce success when requested.
# Globals:
#   KEEP_FONT_ARCHIVES
#   DOWN_DIR
# Arguments:
#   Whether all selected fonts installed successfully (default: true).
# Outputs:
#   Writes archive location and success messages to stdout.
#######################################
post_install() {
    if [[ "$KEEP_FONT_ARCHIVES" == "true" ]]; then
        info "The downloaded font archives can be found in $DOWN_DIR"
    fi
    if [[ "${1:-true}" == "true" ]]; then
        confirm "Enjoy your new fonts!"
    fi
}

#######################################
# Select installed catalog fonts whose saved version is not current.
# Exit with status 0 if all are current or no installed fonts are found.
# Globals:
#   INSTALLED_FONTS
#   SELECTED_FONTS
#   OPERATE_GLOBALLY
# Arguments:
#   None
# Outputs:
#   Writes update status and empty-installation messages to stdout.
#######################################
update_installed_fonts() {
    local font
    get_installed_fonts
    if [[ ${#INSTALLED_FONTS[@]} -ne 0 ]]; then
        for font in "${INSTALLED_FONTS[@]}"; do
            if ! is_latest_version "$font"; then
                SELECTED_FONTS+=("$font")
            fi
        done
        if [[ ${#SELECTED_FONTS[@]} -eq 0 ]]; then
            if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
                confirm "All globally installed Nerd Fonts are up to date."
            else
                confirm "All installed Nerd Fonts are up to date."
            fi
            exit 0
        fi
        if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
            info "Updating globally installed Nerd Fonts: ${SELECTED_FONTS[*]}"
        else
            info "Updating installed Nerd Fonts: ${SELECTED_FONTS[*]}"
        fi
    else
        if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
            info "No globally installed Nerd Fonts found."
        else
            info "No installed Nerd Fonts found."
        fi
        exit 0
    fi
}

#######################################
# Display installed fonts and their saved versions, or unknown version.
# Globals:
#   INSTALLED_FONTS
#   OPERATE_GLOBALLY
# Arguments:
#   None
# Outputs:
#   Writes the installed-font list to stdout.
# Returns:
#   1 if no installed fonts were found, otherwise the last command status.
#######################################
display_installed_fonts() {
    local font
    if [[ ${#INSTALLED_FONTS[@]} -eq 0 ]]; then
        return 1
    fi
    if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
        title "Installed Nerd Fonts (globally):"
    else
        title "Installed Nerd Fonts:"
    fi
    for font in "${INSTALLED_FONTS[@]}"; do
        local font_release_file
        font_release_file="$(get_font_release_file "$font")"
        if [[ -f "$font_release_file" ]]; then
            local font_release_version
            font_release_version=$(cat "$font_release_file")
            printf '%s - %s\n' "$font" "$font_release_version"
        else
            printf '%s - unknown version\n' "$font"
        fi
    done
}

#######################################
# Display the getnf version.
# Globals:
#   VERSION
# Arguments:
#   None
# Outputs:
#   Writes the getnf version to stdout.
#######################################
display_getnf_version() {
    echo "getnf v$VERSION"
}

#######################################
# Display the cached font catalog with the selected release as its heading.
# Globals:
#   RELEASE
#   ALL_FONTS_FILE
# Arguments:
#   None
# Outputs:
#   Writes the heading and catalog to stdout; read errors go to stderr.
#######################################
display_all_fonts() {
    title "Nerd Fonts ${RELEASE}:"
    cat "$ALL_FONTS_FILE"
}

#######################################
# Display numbered font choices in three columns sized for the terminal.
# Globals:
#   RELEASE
#   FONT_OPTIONS
# Arguments:
#   None
# Outputs:
#   Writes the menu to stdout.
#######################################
display_font_menu() {
    local font_index
    local term_width
    term_width=$(stty size | cut -d ' ' -f 2)
    title "Nerd Fonts ${RELEASE}:"
    (
        for font_index in "${!FONT_OPTIONS[@]}"; do
            printf '%d) %s\n' "$((font_index + 1))" "${FONT_OPTIONS[$font_index]}"
        done
        printf 'q) Quit\n'
    ) | pr -3 -t -w "$term_width"
}

#######################################
# Add fonts from an inclusive numeric range to SELECTED_FONTS.
# Selections already added remain if a later index is out of bounds.
# Globals:
#   FONT_OPTIONS
#   SELECTED_FONTS
# Arguments:
#   Numeric range, such as 1-3.
# Outputs:
#   Writes invalid-format and out-of-bounds messages to stdout.
# Returns:
#   1 for invalid format or an out-of-bounds index, 0 otherwise.
#######################################
parse_range() {
    local font_number
    if ! [[ $1 =~ ^[0-9]+-[0-9]+$ ]]; then
        alert "Invalid input format: $1. Expected format: X-Y."
        return 1
    fi
    local -a range
    IFS='-' read -ra range <<< "$1"
    local range_start=${range[0]}
    local range_end=${range[1]}
    for ((font_number = range_start; font_number <= range_end; font_number++)); do
        local index=$((font_number - 1))
        if ((index >= 0 && index < ${#FONT_OPTIONS[@]})); then
            SELECTED_FONTS[index]=${FONT_OPTIONS[index]}
        else
            alert "Invalid option: $font_number. Try again."
            return 1
        fi
    done
}

#######################################
# Read menu selections, retrying on invalid choices until input is accepted.
# Exit with status 0 when the user chooses q.
# Globals:
#   FONT_OPTIONS
#   SELECTED_FONTS
#   ITALIC
#   CYAN
#   RESET
# Arguments:
#   None
# Outputs:
#   Writes prompts to stderr and selection messages to stdout.
#######################################
handle_user_input() {
    local choice
    while true; do
        local choices
        read -erp "${ITALIC}${CYAN}Enter font number(s) (e.g. 1,2,3 or 1-3 or 1,3-5): ${RESET}" choices
        for choice in $(echo "$choices" | tr ',' ' '); do
            if [[ $choice == "q" ]]; then
                confirm "Goodbye!"
                exit 0
            elif [[ $choice == *-* ]]; then
                parse_range "$choice" || continue 2
            elif ((choice >= 1 && choice <= ${#FONT_OPTIONS[@]})); then
                local index=$((choice - 1))
                SELECTED_FONTS[index]=${FONT_OPTIONS[index]}
            else
                alert "Invalid option: $choice. Try again."
                continue 2
            fi
        done
        break
    done
}

#######################################
# Show installed fonts and the menu, then collect selections.
# Globals:
#   INSTALLED_FONTS
#   FONT_OPTIONS
#   SELECTED_FONTS
# Arguments:
#   None
# Outputs:
#   Writes lists and selection messages to stdout and prompts to stderr.
#######################################
menu_install() {
    get_installed_fonts
    filter_installed_fonts

    display_installed_fonts
    display_font_menu
    handle_user_input
}

#######################################
# Collect font selections with fzf and append them to SELECTED_FONTS.
# Globals:
#   INSTALLED_FONTS
#   FONT_OPTIONS
#   SELECTED_FONTS
#   OLIVE
#   RELEASE
#   RESET
#   ITALIC
#   CYAN
# Arguments:
#   None
# Outputs:
#   Displays the fzf interface; writes missing-dependency errors to stderr.
#######################################
fzf_install() {
    local font_name
    ensure_installed fzf

    get_installed_fonts
    filter_installed_fonts
    local fzf_header
    fzf_header=$(printf \
        '%sNerd Fonts %s%s\n%s%sTAB selects • ENTER installs • ESC cancels%s' \
        "$OLIVE" "$RELEASE" "$RESET" "$ITALIC" "$CYAN" "$RESET")
    local fzf_flags=(
        --multi --cycle
        --height=~80% --min-height=12 --layout=reverse --border
        --header="$fzf_header" --header-first
        --color 'pointer:green,marker:green'
    )
    local selected_fonts
    selected_fonts=$(printf '%s\n' "${FONT_OPTIONS[@]}" | fzf "${fzf_flags[@]}")
    for font_name in $selected_fonts; do
        SELECTED_FONTS+=("$font_name")
    done
}

#######################################
# Parse options and dispatch listing, installation, updates, or removal.
# Register cleanup and signal handlers before processing options.
# Globals:
#   KEEP_FONT_ARCHIVES
#   INCLUDE_INSTALLED_FONTS
#   OPERATE_GLOBALLY
#   OPTARG
#   OPTIND
#   SELECTED_FONTS
# Arguments:
#   Command-line options and font selections.
# Outputs:
#   Writes status, listings, and menu validation messages to stdout.
#   Other errors and input prompts go to stderr.
# Returns:
#   0 on success, nonzero on startup failure; dispatched paths may exit.
#######################################
main() {
    local update_installed_fonts='false'
    local uninstall_fonts='false'
    local uninstall_font_names=''
    local display_installed_fonts='false'
    local display_all_fonts='false'
    local install_with_fzf='false'
    local install_font_names=''
    local option font
    local -a installed_fonts=() failed_fonts=()

    trap cleanup EXIT
    trap handle_interrupt INT
    trap handle_termination TERM
    trap handle_hangup HUP

    while getopts ":hkaglLfi:u:UV" option; do
        case "${option}" in
            h) display_help && exit 0 ;;
            k) KEEP_FONT_ARCHIVES='true' ;;
            a) INCLUDE_INSTALLED_FONTS='true' ;;
            g) OPERATE_GLOBALLY='true' ;;
            l) display_installed_fonts='true' ;;
            L) display_all_fonts='true' ;;
            f) install_with_fzf='true' ;;
            i) install_font_names="$OPTARG" ;;
            u)
                uninstall_fonts='true'
                uninstall_font_names="$OPTARG"
                ;;
            U) update_installed_fonts='true' ;;
            V) display_getnf_version && exit 0 ;;
            :) usage_error "Option '-$OPTARG' requires at least one font name." ;;
            *) usage_error "Unknown option: -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))

    if [[ "$uninstall_fonts" == "true" ]]; then
        (($# == 0)) || usage_error "Unexpected argument: $1. Quote multiple font names."
        uninstall_fonts "$uninstall_font_names"
        exit $?
    fi

    check_dependencies || return 1
    get_latest_release_version || return 1
    get_all_fonts || return 1

    if [[ "$display_installed_fonts" == "true" ]]; then
        get_installed_fonts
        if ! display_installed_fonts; then
            if [[ "$OPERATE_GLOBALLY" == "true" ]]; then
                info "No globally installed Nerd Fonts found."
            else
                info "No installed Nerd Fonts found."
            fi
        fi
        exit 0
    fi

    if [[ "$display_all_fonts" == "true" ]]; then
        display_all_fonts
        exit 0
    fi

    SELECTED_FONTS=()
    if [[ "$update_installed_fonts" == "true" ]]; then
        update_installed_fonts
    elif [[ "$install_with_fzf" == "true" ]]; then
        fzf_install
    elif [[ -n "$install_font_names" ]]; then
        direct_install "$install_font_names"
    else
        menu_install
    fi

    if ((${#SELECTED_FONTS[@]} > 0)); then
        title "Selected Nerd Fonts: ${SELECTED_FONTS[*]}"
        for font in "${SELECTED_FONTS[@]}"; do
            if install_font "$font"; then
                installed_fonts+=("$font")
            else
                failed_fonts+=("$font")
            fi
        done
        if ((${#failed_fonts[@]} > 0)); then
            printf '\nInstalled: %s\n' "${installed_fonts[*]:-none}"
            post_install false
            error "Failed to install: ${failed_fonts[*]}."
        fi
        post_install
    else
        error "No fonts were selected, exiting."
    fi
}

main "$@"
